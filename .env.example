# App Info (optional overrides)
VITE_APP_NAME="True Force Security"
VITE_APP_VERSION="1.0.0"

# Contact Details (used in WhatsApp / contact sections)
VITE_WHATSAPP_NUMBER=919876543210
VITE_CONTACT_EMAIL=info@trueforce.in
VITE_CONTACT_PHONE=+919876543210

# Google Maps / Leaflet (optional)
# VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Analytics (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
